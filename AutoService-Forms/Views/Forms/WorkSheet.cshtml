@{ var v = ViewBag.Vehicle as Vehicle; var job = ViewBag.Job as JobOrder; }
<h3>Work Sheet — @v!.Year @v.Make @v.Model</h3>
<form asp-action="WorkSheetSubmit" method="post">
  <input type="hidden" name="vehicleId" value="@v.Id" />
  <input type="hidden" name="jobId" value="@job!.Id" />
  <div class="row g-2">
    <div class="col-md-6"><label class="form-label">Title</label><input name="title" class="form-control" value="Repair Tasks" /></div>
    <div class="col-md-3"><label class="form-label">Mechanic</label><input name="mechanic" class="form-control" /></div>
    <div class="col-md-3"><label class="form-label">Hours (total)</label><input name="hours" class="form-control" /></div>
  </div>
  @for (int i=1;i<=10;i++){ <div class="mt-2"><label class="form-label">Repair Task @i</label><input name="task_@i" class="form-control" /></div> }
  <div class="mt-3"><label class="form-label">Notes</label><textarea name="notes" class="form-control" rows="4"></textarea></div>
  <button class="btn btn-primary mt-3">Сохранить</button>
</form>
