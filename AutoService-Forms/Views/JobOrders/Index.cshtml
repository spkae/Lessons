@model IEnumerable<JobOrder>
@{ ViewData["Title"]="Работы"; }
<h2>@ViewData["Title"]</h2>
<table class="table table-striped"><thead><tr><th>Название</th><th>ТС</th><th>Клиент</th><th>Статус</th><th>Сумма</th><th></th></tr></thead><tbody>
@foreach (var j in Model){ <tr><td>@j.Title</td><td>@($"{j.Vehicle?.Year} {j.Vehicle?.Make} {j.Vehicle?.Model}")</td><td>@j.Vehicle?.Customer?.FullName</td><td>@j.Status</td><td>@j.Subtotal.ToString("0.00")</td><td><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@j.Id">Открыть</a></td></tr> }
</tbody></table>