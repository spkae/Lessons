@model Vehicle
@{ ViewData["Title"]="Добавить авто"; var customers = (IEnumerable<Customer>)ViewBag.Customers; }
<h2>@ViewData["Title"]</h2>
<form method="post"><div class="row g-3">
<div class="col-md-2"><label class="form-label">Год</label><input asp-for="Year" class="form-control" /></div>
<div class="col-md-3"><label class="form-label">Марка</label><input asp-for="Make" class="form-control" /></div>
<div class="col-md-3"><label class="form-label">Модель</label><input asp-for="Model" class="form-control" /></div>
<div class="col-md-4"><label class="form-label">VIN</label><input asp-for="Vin" class="form-control" /></div>
<div class="col-md-4"><label class="form-label">Госномер</label><input asp-for="Plate" class="form-control" /></div>
<div class="col-md-8"><label class="form-label">Клиент</label><select asp-for="CustomerId" class="form-select">
@foreach (var c in customers){ <option value="@c.Id">@c.FullName</option> }</select></div>
</div><div class="mt-3"><button class="btn btn-primary">Сохранить</button><a class="btn btn-outline-secondary" asp-action="Index">Отмена</a></div></form>