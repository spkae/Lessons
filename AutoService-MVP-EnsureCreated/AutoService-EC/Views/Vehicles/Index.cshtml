@model IEnumerable<Vehicle>
@{ ViewData["Title"]="Транспортные средства"; }
<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>@ViewData["Title"]</h2>
  <a class="btn btn-primary" asp-action="Create">+ Добавить авто</a>
</div>
<table class="table table-striped"><thead><tr><th>Год</th><th>Марка</th><th>Модель</th><th>VIN</th><th>Госномер</th><th>Клиент</th><th></th></tr></thead><tbody>
@foreach (var v in Model){ <tr><td>@v.Year</td><td>@v.Make</td><td>@v.Model</td><td>@v.Vin</td><td>@v.Plate</td><td>@v.Customer?.FullName</td><td><a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@v.Id">Открыть</a></td></tr> }
</tbody></table>