@model JobOrder
@{ ViewData["Title"]="Создать работу"; var sel = (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewData["VehicleId"]; }
<h2>@ViewData["Title"]</h2>
<form method="post"><div class="row g-3">
<div class="col-md-6"><label class="form-label">ТС</label><select asp-for="VehicleId" class="form-select" asp-items="sel"></select></div>
<div class="col-md-6"><label class="form-label">Название</label><input asp-for="Title" class="form-control" /></div>
<div class="col-md-4"><label class="form-label">Статус</label><select asp-for="Status" class="form-select"><option value="0">Planned</option><option value="1">InProgress</option><option value="2">Completed</option></select></div>
<div class="col-md-4"><label class="form-label">Часы</label><input asp-for="LaborHours" class="form-control" /></div>
<div class="col-md-4"><label class="form-label">Ставка</label><input asp-for="LaborRate" class="form-control" /></div>
<div class="col-12"><label class="form-label">Заметки</label><textarea asp-for="Notes" class="form-control"></textarea></div>
</div><div class="mt-3"><button class="btn btn-primary">Создать</button><a class="btn btn-outline-secondary" asp-action="Index">Отмена</a></div></form>