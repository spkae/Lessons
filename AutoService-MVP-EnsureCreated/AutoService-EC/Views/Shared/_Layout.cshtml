@{ var title = ViewData["Title"] as string ?? "AutoService"; }
<!DOCTYPE html><html lang="ru"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><title>@title - AutoService</title><link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" /></head>
<body><nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4"><div class="container">
<a class="navbar-brand" asp-controller="Vehicles" asp-action="Index">AutoService</a>
<div class="collapse navbar-collapse"><ul class="navbar-nav me-auto">
<li class="nav-item"><a class="nav-link" asp-controller="Vehicles" asp-action="Index">Транспорт</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="JobOrders" asp-action="Index">Работы</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Parts" asp-action="Index">Запчасти</a></li>
<li class="nav-item"><a class="nav-link" asp-controller="Customers" asp-action="Index">Клиенты</a></li>
</ul></div></div></nav>
<main class="container">@RenderBody()</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@RenderSection("Scripts", required: false)</body></html>