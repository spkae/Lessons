@model Customer
@{ ViewData["Title"]="Добавить клиента"; }
<h2>@ViewData["Title"]</h2>
<form method="post"><div class="row g-3">
<div class="col-md-6"><label class="form-label">ФИО</label><input asp-for="FullName" class="form-control" /></div>
<div class="col-md-3"><label class="form-label">Телефон</label><input asp-for="Phone" class="form-control" /></div>
<div class="col-md-3"><label class="form-label">Email</label><input asp-for="Email" class="form-control" /></div>
</div><div class="mt-3"><button class="btn btn-primary">Сохранить</button><a class="btn btn-outline-secondary" asp-action="Index">Отмена</a></div></form>